# Local development — copy to .env and fill in your values:
#   copy .env.example .env
# .env is gitignored — never commit it.
#
# EC2 production uses .env.production.example instead.

DJANGO_SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,*

DATABASE_ENGINE=mssql

# Used when DATABASE_ENGINE=sqlite (Part B local test, or after export)
DATABASE_PATH=db.sqlite3

# Used when DATABASE_ENGINE=mssql (local dev)
DATABASE_NAME=NFL Top 100
DATABASE_HOST=DESKTOP-AB3PKMH\SQLEXPRESS01
DATABASE_PORT=
DATABASE_USER=mt
DATABASE_PASSWORD=your_password_here
